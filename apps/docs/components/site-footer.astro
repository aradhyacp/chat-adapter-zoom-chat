---
/**
 * Replaces Blume's single-row footer. It keeps the repository and npm links
 * the built-in footer is the only place to carry.
 */
// BASE_URL has no trailing slash when a base path is set, so normalise it.
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
// biome-ignore lint/correctness/noUnusedVariables: Astro template expressions are opaque to this rule; every binding below is rendered in the markup.
const year = new Date().getFullYear();

// biome-ignore lint/correctness/noUnusedVariables: Astro template expressions are opaque to this rule; every binding below is rendered in the markup.
const columns = [
  {
    heading: "Start",
    links: [
      { href: `${base}quickstart`, label: "Quickstart" },
      { href: `${base}marketplace-setup`, label: "Marketplace setup" },
      { href: `${base}configuration`, label: "Configuration" },
    ],
  },
  {
    heading: "Reference",
    links: [
      { href: `${base}webhooks`, label: "Webhooks" },
      { href: `${base}messaging`, label: "Messaging" },
      { href: `${base}reference`, label: "API reference" },
    ],
  },
  {
    heading: "Honesty",
    links: [
      { href: `${base}limitations`, label: "Limitations" },
      { href: `${base}troubleshooting`, label: "Troubleshooting" },
      {
        href: "https://github.com/aradhyacp/zoom-chat-adapter/issues",
        label: "Report an issue",
      },
    ],
  },
];
---

<footer class="ft">
  <div class="ft-grid">
    <div>
      <h2>zoom-chat-adapter</h2>
      <p class="ft-about">
        A community Zoom Team Chat adapter for Chat SDK. Not published, reviewed, or
        supported by Zoom.
      </p>
      <div class="ft-marks">
        <a
          class="ft-mark"
          href="https://github.com/aradhyacp/zoom-chat-adapter"
          aria-label="zoom-chat-adapter on GitHub"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.55v-2.1c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.3-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.3-.52-1.47.11-3.07 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.6.23 2.78.12 3.07.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.26 5.69.41.36.78 1.06.78 2.14v3.17c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"
            ></path>
          </svg>
          <span>GitHub</span>
        </a>
        <a
          class="ft-mark"
          href="https://www.npmjs.com/package/zoom-chat-adapter"
          aria-label="zoom-chat-adapter on npm"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M0 7.334v8h6.666v1.332H12v-1.332h12v-8H0zm6.666 6.664H5.334v-4H3.999v4H1.335V8.667h5.331v5.331zm4 0v1.336H8.001V8.667h5.332v5.331h-2.667zm12.001 0h-1.33v-4h-1.336v4h-1.335v-4h-1.33v4h-2.671V8.667h8.002v5.331zM10.665 10H12v2.667h-1.335V10z"
            ></path>
          </svg>
          <span>npm</span>
        </a>
      </div>
    </div>
    {
      columns.map((column) => (
        <div>
          <h2>{column.heading}</h2>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <p class="ft-colophon">© {year} zoom-chat-adapter contributors · MIT licence</p>
</footer>
