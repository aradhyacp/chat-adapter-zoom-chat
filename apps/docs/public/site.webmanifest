{
  "name": "zoom-chat-adapter",
  "short_name": "zoom-chat-adapter",
  "description": "Community Zoom Team Chat adapter for Chat SDK — channels, DMs, slash commands, and @-mentions through one Chat interface.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fdfcfc",
  "theme_color": "#fdfcfc",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
